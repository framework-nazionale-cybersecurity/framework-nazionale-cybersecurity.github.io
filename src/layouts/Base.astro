---
/**
 * Impaginazione del sito.
 *
 * Riproduce l'aspetto del sito Drupal originale con CSS proprio. Menu e spalla
 * sono componenti alimentati da file di dati (src/dati/), le pagine sono
 * Markdown: per cambiare l'aspetto del sito si interviene qui, nei componenti e
 * in public/stili/sito.css, senza toccare i contenuti.
 */
import Menu from '../componenti/Menu.astro';
import Spalla from '../componenti/Spalla.astro';

interface Props {
  titolo: string;
  lingua: 'it' | 'en';
  descrizione?: string;
  canonico?: string;
  noindex?: boolean;
  /** Indirizzo della pagina corrente. */
  url: string;
  /** Dati della pagina, servono al menu per voce attiva e bandierine. */
  pagina: {
    lingua: 'it' | 'en' | 'und';
    indirizzi: string[];
    rinvii: string[];
    traduzione?: string;
  };
}

const { titolo, lingua, descrizione, canonico, noindex = false, url, pagina } = Astro.props;
const anteprima = import.meta.env.PUBLIC_AMBIENTE === 'anteprima';

const NOME_SITO = 'Framework Nazionale per la Cybersecurity e la Data Protection';
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo} | {NOME_SITO}</title>
    {descrizione && <meta name="description" content={descrizione} />}
    {canonico && <link rel="canonical" href={new URL(canonico, Astro.site)} />}
    {(noindex || anteprima) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/sites/default/files/favicon_0.ico" />
    <link rel="stylesheet" href="/stili/sito.css" />
  </head>

  <body>
    {anteprima && (
      <p class="nastro-anteprima">Anteprima privata — non è il sito pubblico.</p>
    )}

    <a class="salta" href="#contenuto">Vai al contenuto</a>

    <div class="banda-testata">
      <div class="contenitore">
        <p class="titolo-sito"><a href={lingua === 'en' ? '/en' : '/'}>{NOME_SITO}</a></p>
      </div>
    </div>

    <div class="banda-menu">
      <div class="contenitore menu_wrapper"><Menu url={url} pagina={pagina} /></div>
    </div>

    <div class="contenitore corpo">
      <aside class="spalla region-sidebar-first"><Spalla /></aside>
      <main id="contenuto" class="contenuto">
        <slot />
      </main>
    </div>

    <footer class="piede">
      <div class="contenitore">
        <p>
          Una collaborazione tra il Centro di ricerca CIS — Sapienza Università di Roma
          e il Laboratorio Nazionale di Cybersecurity del CINI.
        </p>
        <p><a href="mailto:info@cybersecurityframework.it">info@cybersecurityframework.it</a></p>
      </div>
    </footer>
  </body>
</html>
