---
/**
 * Impaginazione del porting fedele.
 *
 * Riproduce l'aspetto del tema Drupal `execute_responsive_theme` con CSS
 * proprio, misurato sugli stili calcolati del sito vivo. Non ne riusa il
 * foglio di stile: e' un tema commerciale, e il repository diventera' pubblico.
 * Il risultato deve somigliare all'originale, non discenderne.
 *
 * Menu e spalla NON sono ricostruiti qui: arrivano gia' resi da Drupal,
 * catturati URL per URL. Il menu cambia fra italiano e inglese, evidenzia la
 * voce attiva e il selettore di lingua punta alla traduzione: regole che
 * riscritte a mano sarebbero sei occasioni di sbagliare in silenzio.
 *
 * Il revamp resta previsto, ma dopo la messa in sicurezza.
 */
interface Props {
  titolo: string;
  lingua: 'it' | 'en';
  descrizione?: string;
  canonico?: string;
  noindex?: boolean;
  menu: string;
  spalla: string;
}

const { titolo, lingua, descrizione, canonico, noindex = false, menu, spalla } = Astro.props;
const anteprima = import.meta.env.PUBLIC_AMBIENTE === 'anteprima';

const NOME_SITO = 'Framework Nazionale per la Cybersecurity e la Data Protection';
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo} | {NOME_SITO}</title>
    {descrizione && <meta name="description" content={descrizione} />}
    {canonico && <link rel="canonical" href={new URL(canonico, Astro.site)} />}
    {(noindex || anteprima) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/sites/default/files/favicon_0.ico" />
    <link rel="stylesheet" href="/stili/sito.css" />
  </head>

  <body>
    {anteprima && (
      <p class="nastro-anteprima">Anteprima privata — non è il sito pubblico.</p>
    )}

    <a class="salta" href="#contenuto">Vai al contenuto</a>

    <div class="banda-testata">
      <div class="contenitore">
        <p class="titolo-sito"><a href={lingua === 'en' ? '/en' : '/'}>{NOME_SITO}</a></p>
      </div>
    </div>

    <div class="banda-menu">
      <div class="contenitore menu_wrapper" set:html={menu} />
    </div>

    <div class="contenitore corpo">
      <aside class="spalla region-sidebar-first" set:html={spalla} />
      <main id="contenuto" class="contenuto">
        <slot />
      </main>
    </div>

    <footer class="piede">
      <div class="contenitore">
        <p>
          Una collaborazione tra il Centro di ricerca CIS — Sapienza Università di Roma
          e il Laboratorio Nazionale di Cybersecurity del CINI.
        </p>
        <p><a href="mailto:info@cybersecurityframework.it">info@cybersecurityframework.it</a></p>
      </div>
    </footer>
  </body>
</html>
