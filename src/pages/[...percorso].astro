---
/**
 * Rotta unica: genera ogni indirizzo del sito a partire dalle pagine.
 *
 * Ogni file in content/ dichiara nel proprio front-matter:
 *   indirizzi  dove la pagina viene servita (il primo e' il principale)
 *   rinvii     indirizzi storici che devono continuare a funzionare
 *
 * I rinvii producono una pagina con rel=canonical e meta refresh: GitHub Pages
 * non offre redirect lato server. Non e' un 301, ma consolida il segnale per i
 * motori di ricerca ed e' trasparente per chi naviga.
 *
 * Se due pagine dichiarano lo stesso indirizzo la build si ferma: e' l'errore
 * piu' facile da commettere aggiungendo una pagina copiandone un'altra.
 */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Immagine from '../componenti/Immagine.astro';
import Video from '../componenti/Video.astro';

export async function getStaticPaths() {
  const pagine = await getCollection('pagine');
  const rotte: any[] = [];
  const dichiarati = new Map<string, string>();

  const registra = (indirizzo: string, origine: string) => {
    const gia = dichiarati.get(indirizzo);
    if (gia) throw new Error(`L'indirizzo ${indirizzo} è dichiarato due volte: in ${gia} e in ${origine}`);
    dichiarati.set(indirizzo, origine);
  };
  const parametro = (u: string) => u.replace(/^\//, '') || undefined;

  for (const pagina of pagine) {
    const { indirizzi, rinvii } = pagina.data;

    for (const url of indirizzi) {
      registra(url, pagina.id);
      rotte.push({ params: { percorso: parametro(url) }, props: { pagina, url, rinvioVerso: null } });
    }

    for (const url of rinvii) {
      registra(url, pagina.id);
      // Un indirizzo sotto /en rinvia alla versione inglese, se esiste.
      const inglese = url.startsWith('/en');
      const meta =
        (inglese ? indirizzi.find((u) => u.startsWith('/en')) : indirizzi.find((u) => !u.startsWith('/en'))) ??
        indirizzi[0];
      rotte.push({ params: { percorso: parametro(url) }, props: { pagina, url, rinvioVerso: meta } });
    }
  }
  return rotte;
}

const { pagina, url, rinvioVerso } = Astro.props;
const inglese = url === '/en' || url.startsWith('/en/');
const { Content } = await render(pagina);

/**
 * Sotto /en Drupal faceva restare chi naviga nell'interfaccia inglese: i
 * collegamenti interni alle pagine prendevano il prefisso /en, quelli ai file
 * no. Da /en/csr2016 il modello dei costi e' quindi /en/modelloStimaCosti.
 *
 * Si applica alle pagine non inglesi servite sotto /en, il cui testo e' scritto
 * con gli indirizzi italiani. Solo ai .md: e' di questi che Astro conserva
 * l'HTML gia' reso, su cui fare la sostituzione.
 */
function prefissaInterni(html: string) {
  return html.replace(/(\bhref\s*=\s*")(\/[^"]*)(")/gi, (intero, a, u, z) => {
    if (u === '/en' || u.startsWith('/en/')) return intero;
    if (/^\/(sites|stili)\//i.test(u)) return intero;
    return `${a}/en${u === '/' ? '' : u}${z}`;
  });
}
const htmlInglese =
  inglese && pagina.data.lingua !== 'en' && pagina.rendered?.html ? prefissaInterni(pagina.rendered.html) : null;
---

{
  rinvioVerso ? (
    <html lang={inglese ? 'en' : 'it'}>
      <head>
        <meta charset="utf-8" />
        <title>{pagina.data.titolo}</title>
        <link rel="canonical" href={new URL(rinvioVerso, Astro.site)} />
        <meta http-equiv="refresh" content={`0; url=${rinvioVerso}`} />
        <meta name="robots" content="noindex, follow" />
      </head>
      <body>
        <p>
          Questa pagina si trova ora in <a href={rinvioVerso}>{rinvioVerso}</a>.
        </p>
      </body>
    </html>
  ) : (
    <Base titolo={pagina.data.titolo} lingua={inglese ? 'en' : 'it'} canonico={url} url={url} pagina={pagina.data}>
      <h1 class="page-title">{pagina.data.titolo}</h1>
      <div class="region region-content">
        {htmlInglese !== null ? <Fragment set:html={htmlInglese} /> : <Content components={{ Immagine, Video }} />}
      </div>
    </Base>
  )
}
